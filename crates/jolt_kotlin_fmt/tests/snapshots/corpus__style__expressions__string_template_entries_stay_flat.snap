}

fun templateWhenEntries(x: Int, y: Int) {
  val compact = "result: ${when (x) { 1 -> "one"; 2 -> "two"; else -> "other" }}"
  val raw = """result: ${when (x) { 1 -> "one"; else -> "other" }}"""
