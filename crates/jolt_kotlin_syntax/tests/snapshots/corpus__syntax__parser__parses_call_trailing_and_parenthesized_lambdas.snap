input:
fun trailing(values: List<Int>) {
    values.map { it + 1 }
        .filter({ value -> value > 2 })
        .fold(0) { acc, value ->
            acc + value
        }
}

class Cached<T>(private val init: (Int) -> T) {
    init {
        require(true)
    }

    private val values = List(8) { init(it) }
}

fun annotatedLambdas() {
    run @Suppress("x") { 1 }
    run() @Suppress("x") { 1 }
    items.forEach @Synchronized { consume(it) }
    run @kotlin.Suppress @Deprecated("old") { 2 }
    run(@Suppress("x") { 3 })
}

