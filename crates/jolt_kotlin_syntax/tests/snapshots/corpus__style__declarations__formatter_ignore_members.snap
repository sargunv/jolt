class FormatterIgnoreMembers {
val before=1
  // @formatter:off
  val raw=1+2
  val label="x"
  // @formatter:on
val after=2

  // @formatter:off
  fun   raw( ) { }

  // @formatter:on
  fun formatted() {}

fun nested() {
if (true) {
// @formatter:off
val rawLocal=3+4
call( a,b )
// @formatter:on
val afterLocal=5
}
}
}

