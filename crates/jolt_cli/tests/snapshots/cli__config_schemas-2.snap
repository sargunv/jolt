---
source: crates/jolt_cli/tests/cli.rs
expression: "project.run(&[\"config\", \"schema\", \"--dprint\"], \"\")"
---
$ jolt config schema --dprint
status: 0
--- stdout
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "jolt": {
      "additionalProperties": false,
      "description": "Jolt formatting options. An unset option falls through to a less specific layer, and finally to its default.",
      "properties": {
        "associations": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "Glob patterns of the files this plugin formats (read by dprint)."
        },
        "indentWidth": {
          "description": "Spaces per indentation level when not using tabs.",
          "format": "uint8",
          "minimum": 1.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lineWidth": {
          "description": "Preferred maximum line width.",
          "format": "uint16",
          "minimum": 1.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "locked": {
          "description": "Read by dprint itself; see its configuration documentation.",
          "type": "boolean"
        },
        "useTabs": {
          "description": "Indent with tabs instead of spaces.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "title": "dprint jolt plugin configuration",
  "type": "object"
}
