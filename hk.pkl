amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

steps {
    ["cargo-check-wasm"] {
        glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
        check = "cargo check --target wasm32-unknown-unknown --package jolt_syntax --package jolt_java_syntax --package jolt_fmt --package jolt_java_fmt --package jolt_formatter --package jolt_config --package jolt_fmt_dprint"
    }
    ["cargo-clippy"] {
        glob = List("**/*.rs")
        check = "cargo clippy --workspace --all-targets --all-features -- -D warnings"
    }
    ["cargo-doc"] {
        glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
        check = "RUSTDOCFLAGS='-D warnings' cargo doc --workspace --no-deps --document-private-items"
    }
    ["cargo-machete"] {
        glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
        check = "cargo machete"
        fix = "cargo machete --fix"
    }
    ["dprint"] = (Builtins.dprint) {
        exclude = List("**/*.snap", "fixtures/java/**")
    }
}

